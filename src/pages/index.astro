---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";

const [{ entries: posts }, { entries: projects }, { entries: experience }] = await Promise.all([
	getEmDashCollection("posts", { limit: 5, orderBy: { created_at: "desc" } }),
	getEmDashCollection("projects", { limit: 6, orderBy: { created_at: "desc" } }),
	getEmDashCollection("experience", { orderBy: { created_at: "desc" } }),
]);

function formatDate(d?: string | Date | null) {
	if (!d) return "";
	const date = typeof d === "string" ? new Date(d) : d;
	return date.toLocaleDateString("en-US", { year: "numeric", month: "short" });
}
---

<Base title="Eryandhi Putro Nugroho">
	{/* Hero Section */}
	<section class="hero-section">
		<div class="container-narrow">
			<div class="hero-badge">
				<span class="active-dot"></span>
				<span class="badge-text">pipeline: active // available for projects</span>
			</div>

			<h1 class="hero-title">
				Eryandhi Putro<br />
				<span class="hero-accent">Nugroho</span>
			</h1>

			<p class="hero-bio">
				Software engineer from Ponorogo, Indonesia — building full-stack web systems,
				IoT solutions, and computer vision prototypes. Passionate about clean architecture,
				developer tooling, and shipping products that actually work.
			</p>

			<div class="hero-tags">
				<span class="badge">Fullstack .NET</span>
				<span class="badge">TypeScript</span>
				<span class="badge">Go</span>
				<span class="badge">Python</span>
				<span class="badge">Computer Vision</span>
				<span class="badge">IoT</span>
				<span class="badge">Vue 3 / Astro</span>
			</div>

			<div class="hero-cta">
				<a href="/posts" class="btn btn-primary">Read Articles →</a>
				<a href="/work" class="btn btn-secondary">View Projects</a>
				<a href="/about#cv" class="btn btn-secondary">Download CV</a>
			</div>
		</div>
	</section>

	{/* Experience Timeline */}
	{experience.length > 0 && (
		<section class="section">
			<div class="container-narrow">
				<div class="section-header">
					<h2 class="section-title">experience.log</h2>
					<span class="section-subtitle">Career & competitions timeline</span>
				</div>

				<div class="timeline">
					{experience.map((job, idx) => {
						const isCurrent = job.data.is_current;
						const start = formatDate(job.data.start_date);
						const end = isCurrent ? "Present" : (job.data.end_date ? formatDate(job.data.end_date) : "");
						return (
							<div class="timeline-item">
								<div class="timeline-marker">
									<div class={`marker-dot ${isCurrent ? 'active' : ''}`}></div>
									{idx < experience.length - 1 && <div class="marker-line"></div>}
								</div>
								<div class="timeline-card">
									<div class="timeline-header">
										<h3 class="timeline-role">{job.data.role}</h3>
										<span class="timeline-company">@ {job.data.company}</span>
										{isCurrent && <span class="badge badge-current">current</span>}
									</div>
									<div class="timeline-dates">{start} → {end}</div>
									{job.data.description && <p class="timeline-desc">{job.data.description}</p>}
								</div>
							</div>
						);
					})}
				</div>
			</div>
		</section>
	)}

	{/* Featured Projects */}
	{projects.length > 0 && (
		<section class="section section-alt">
			<div class="container-narrow">
				<div class="section-header">
					<h2 class="section-title">featured_work.sys</h2>
					<a href="/work" class="section-link">All projects ({projects.length}) →</a>
				</div>

				<div class="projects-grid">
					{projects.map((proj) => (
						<article class="project-card">
							<div class="project-header">
								<h3 class="project-title">
									<a href={`/work/${proj.id}`}>{proj.data.title}</a>
								</h3>
								{proj.data.tech_stack && (
									<span class="project-tech">{proj.data.tech_stack}</span>
								)}
							</div>
							{proj.data.summary && (
								<p class="project-summary">{proj.data.summary}</p>
							)}
							<div class="project-links">
								<a href={`/work/${proj.id}`} class="project-link">Details →</a>
								{proj.data.url && (
									<a href={proj.data.url} target="_blank" rel="noopener noreferrer" class="project-link">Live Demo ↗</a>
								)}
								{proj.data.github_url && (
									<a href={proj.data.github_url} target="_blank" rel="noopener noreferrer" class="project-link">GitHub ↗</a>
								)}
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	)}

	{/* Latest Articles */}
	{posts.length > 0 && (
		<section class="section">
			<div class="container-narrow">
				<div class="section-header">
					<h2 class="section-title">latest_writing.md</h2>
					<a href="/posts" class="section-link">All articles →</a>
				</div>

				<div class="articles-list">
					{posts.map((post) => (
						<article class="article-item">
							<a href={`/posts/${post.id}`} class="article-link">
								<div class="article-item-meta">
									<time>{formatDate(post.data.createdAt)}</time>
									<span class="byline-sep"></span>
									<span>Eryandhi Putro Nugroho</span>
								</div>
								<h3 class="article-item-title">{post.data.title}</h3>
								{post.data.excerpt && (
									<p class="article-item-excerpt">{post.data.excerpt}</p>
								)}
								<span class="article-read-more">Read article →</span>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>
	)}
</Base>

<style>
	/* Hero */
	.hero-section {
		padding: var(--spacing-16) 0 var(--spacing-12);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-4);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
	}

	.hero-badge .active-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
	}

	.hero-title {
		font-family: var(--font-sans);
		font-size: clamp(2.5rem, 6vw, 3.75rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin-bottom: var(--spacing-4);
	}

	.hero-accent {
		color: var(--color-brand);
	}

	.hero-bio {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		line-height: 1.7;
		color: var(--color-text-secondary);
		max-width: 600px;
		margin-bottom: var(--spacing-6);
	}

	.hero-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-8);
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
	}

	/* Sections */
	.section {
		padding: var(--spacing-16) 0;
	}

	.section-alt {
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border-subtle);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
		padding-bottom: var(--spacing-3);
	}

	.section-title {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
		font-weight: 600;
	}

	.section-subtitle {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.section-link {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		color: var(--color-brand);
		font-weight: 500;
	}

	.section-link:hover {
		text-decoration: underline;
	}

	/* Timeline */
	.timeline {
		display: flex;
		flex-direction: column;
	}

	.timeline-item {
		display: flex;
		gap: var(--spacing-4);
		position: relative;
	}

	.timeline-marker {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 20px;
		flex-shrink: 0;
	}

	.marker-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 2px solid var(--color-border);
		background: var(--color-bg);
		margin-top: 6px;
	}

	.marker-dot.active {
		border-color: #10b981;
		background: #10b981;
		box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2);
	}

	.marker-line {
		flex: 1;
		width: 2px;
		background: var(--color-border-subtle);
		margin: 4px 0;
	}

	.timeline-card {
		flex: 1;
		padding-bottom: var(--spacing-8);
	}

	.timeline-header {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-2);
		flex-wrap: wrap;
	}

	.timeline-role {
		font-family: var(--font-sans);
		font-size: var(--font-size-base);
		font-weight: 700;
		color: var(--color-text);
	}

	.timeline-company {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		color: var(--color-brand);
	}

	.badge-current {
		background: rgba(16, 185, 129, 0.1);
		color: #10b981;
		border-color: rgba(16, 185, 129, 0.3);
		font-size: 10px;
		padding: 1px 6px;
	}

	.timeline-dates {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-top: 2px;
		margin-bottom: var(--spacing-2);
	}

	.timeline-desc {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
	}

	/* Projects Grid */
	.projects-grid {
		display: grid;
		gap: var(--spacing-6);
	}

	.project-card {
		padding: var(--spacing-6);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		transition: all var(--transition-fast);
	}

	.project-card:hover {
		border-color: var(--color-muted);
		box-shadow: var(--shadow-sm);
	}

	.project-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--spacing-4);
		flex-wrap: wrap;
		margin-bottom: var(--spacing-2);
	}

	.project-title {
		font-family: var(--font-sans);
		font-size: var(--font-size-lg);
		font-weight: 700;
	}

	.project-title a {
		color: var(--color-text);
	}

	.project-title a:hover {
		color: var(--color-brand);
	}

	.project-tech {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.project-summary {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
		margin-bottom: var(--spacing-4);
	}

	.project-links {
		display: flex;
		gap: var(--spacing-4);
	}

	.project-link {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-brand);
	}

	.project-link:hover {
		text-decoration: underline;
	}

	/* Articles List */
	.articles-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}

	.article-item {
		padding-bottom: var(--spacing-6);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.article-item:last-child {
		border-bottom: none;
	}

	.article-link {
		display: block;
	}

	.article-item-meta {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-2);
	}

	.article-item-title {
		font-family: var(--font-sans);
		font-size: var(--font-size-xl);
		font-weight: 700;
		color: var(--color-text);
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.article-link:hover .article-item-title {
		color: var(--color-brand);
	}

	.article-item-excerpt {
		font-family: var(--font-serif);
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		margin-bottom: var(--spacing-2);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.article-read-more {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-brand);
	}
</style>
