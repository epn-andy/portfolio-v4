---
import { getEmDashEntry, getEmDashCollection, getSeoMeta, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const siteTitle = "Eryandhi Putro Nugroho";
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Reading time from portable text
function getReadingTime(blocks: unknown): number {
	if (!Array.isArray(blocks)) return 1;
	let words = 0;
	for (const block of blocks) {
		const b = block as Record<string, unknown>;
		const children = b.children as Array<Record<string, unknown>> | undefined;
		if (Array.isArray(children)) {
			for (const child of children) {
				if (typeof child.text === "string") {
					words += child.text.split(/\s+/).filter(Boolean).length;
				}
			}
		}
	}
	return Math.max(1, Math.round(words / 200));
}

const readingTime = getReadingTime(post.data.content);

const publishDate = post.data.publishedAt?.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
}) ?? post.data.createdAt?.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
}) ?? null;

const tags = (post.data.terms?.tag ?? []) as Array<{ slug: string; label: string }>;
const categories = (post.data.terms?.category ?? []) as Array<{ slug: string; label: string }>;

// Related posts
const { entries: recentPosts } = await getEmDashCollection("posts", {
	orderBy: { created_at: "desc" },
	limit: 4,
});
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt?.toISOString() ?? null}
	content={{ collection: "posts", id: post.data.id, slug }}
	showProgressBar={true}
>
	<article class="article-wrap">
		{/* Title */}
		<header>
			{categories.length > 0 && (
				<div class="article-kicker">
					{categories.map((c) => (
						<a href={`/category/${c.slug}`} class="kicker-link">{c.label}</a>
					))}
				</div>
			)}

			<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>

			{post.data.excerpt && (
				<p class="article-subtitle" {...post.edit.excerpt}>{post.data.excerpt}</p>
			)}

			{/* Medium-style byline bar */}
			<div class="byline-bar">
				<div class="byline-avatar">EP</div>
				<div class="byline-info">
					<span class="byline-author">
						<a href="/about">Eryandhi Putro Nugroho</a>
					</span>
					<span class="byline-meta">
						{publishDate && <time>{publishDate}</time>}
						{publishDate && <span class="byline-sep"></span>}
						<span>{readingTime} min read</span>
					</span>
				</div>
				<div class="byline-actions">
					<button
						class="byline-action-btn"
						id="share-btn"
						type="button"
						title="Copy link"
						aria-label="Copy link to clipboard"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
							<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
						</svg>
					</button>
					<button
						class="byline-action-btn"
						id="bookmark-btn"
						type="button"
						title="Bookmark"
						aria-label="Bookmark this article"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
						</svg>
					</button>
				</div>
			</div>
		</header>

		{/* Body */}
		<div class="prose">
			<PortableText value={post.data.content} />
		</div>

		{/* Article footer: tags + share */}
		<footer class="article-footer">
			<div class="article-tags">
				{tags.map((t) => (
					<a href={`/tag/${t.slug}`} class="article-tag">{t.label}</a>
				))}
			</div>
			<div class="article-share">
				<a
					class="btn btn-secondary"
					href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
					target="_blank"
					rel="noopener noreferrer"
				>Share on X</a>
				<a
					class="btn btn-secondary"
					href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
					target="_blank"
					rel="noopener noreferrer"
				>LinkedIn</a>
			</div>
		</footer>
	</article>

	{/* Related posts */}
	{otherPosts.length > 0 && (
		<section class="more-posts">
			<h2 class="more-title">Continue reading</h2>
			<div class="more-grid">
				{otherPosts.map((p) => (
					<article class="related-card">
						<a href={`/posts/${p.id}`} class="related-link">
							<div class="related-meta">
								{p.data.createdAt && (
									<time>{p.data.createdAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>
								)}
							</div>
							<h3 class="related-title">{p.data.title}</h3>
							{p.data.excerpt && <p class="related-excerpt">{p.data.excerpt}</p>}
						</a>
					</article>
				))}
			</div>
		</section>
	)}

	<script>
		// Copy link button
		const shareBtn = document.getElementById("share-btn");
		if (shareBtn) {
			shareBtn.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(window.location.href);
					shareBtn.style.color = "var(--color-brand)";
					setTimeout(() => { shareBtn.style.color = ""; }, 1500);
				} catch (e) {
					/* clipboard unavailable */
				}
			});
		}

		// Bookmark button (localStorage)
		const bookmarkBtn = document.getElementById("bookmark-btn");
		if (bookmarkBtn) {
			const key = "bookmark:" + window.location.pathname;
			const isBookmarked = () => localStorage.getItem(key) === "1";
			const paint = () => {
				bookmarkBtn.style.color = isBookmarked() ? "var(--color-brand)" : "";
				bookmarkBtn.querySelector("path")?.setAttribute("fill", isBookmarked() ? "currentColor" : "none");
			};
			paint();
			bookmarkBtn.addEventListener("click", () => {
				if (isBookmarked()) localStorage.removeItem(key);
				else localStorage.setItem(key, "1");
				paint();
			});
		}
	</script>
</Base>

<style>
	.article-kicker {
		display: flex;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-3);
		font-family: var(--font-sans);
	}

	.kicker-link {
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-brand);
	}

	.kicker-link:hover {
		text-decoration: underline;
	}

	/* Related posts cards */
	.related-card {
		min-width: 0;
	}

	.related-link {
		display: block;
	}

	.related-meta {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	.related-title {
		font-family: var(--font-sans);
		font-size: var(--font-size-base);
		font-weight: 700;
		line-height: var(--leading-snug);
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.related-link:hover .related-title {
		color: var(--color-brand);
	}

	.related-excerpt {
		font-family: var(--font-serif);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
