---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: posts } = await getEmDashCollection("posts", {
	orderBy: { created_at: "desc" },
	limit: 50,
});

const termsResult = await getTaxonomyTermsWithCacheHint("category", { includeCounts: true });
const categories = termsResult?.data ?? [];

function formatDate(d?: string | Date | null) {
	if (!d) return "";
	const date = typeof d === "string" ? new Date(d) : d;
	return date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<Base
	title="Articles"
	description="Engineering blog posts on software architecture, .NET, AI assistants, SQL optimization, and backend systems."
>
	<div class="container-narrow articles-page">
		<header class="page-header">
			<h1 class="page-title">Articles</h1>
			<p class="page-desc">
				Thoughts on clean architecture, AI tooling, SQL performance, and building resilient systems.
			</p>

			{categories.length > 0 && (
				<div class="category-pills">
					<a href="/posts" class="cat-pill active">All</a>
					{categories.map((c) => (
						<a href={`/category/${c.slug}`} class="cat-pill">{c.label}</a>
					))}
				</div>
			)}
		</header>

		<div class="posts-feed">
			{posts.map((post) => (
				<article class="feed-item">
					<a href={`/posts/${post.id}`} class="feed-link">
						<div class="feed-meta">
							<span class="feed-author">Eryandhi Putro</span>
							<span class="byline-sep"></span>
							<time>{formatDate(post.data.createdAt)}</time>
						</div>

						<h2 class="feed-title">{post.data.title}</h2>

						{post.data.excerpt && (
							<p class="feed-excerpt">{post.data.excerpt}</p>
						)}

						<div class="feed-footer">
							<span class="feed-read-time">Read article →</span>
						</div>
					</a>
				</article>
			))}

			{posts.length === 0 && (
				<div class="empty-state">
					<p>No articles published yet.</p>
				</div>
			)}
		</div>
	</div>
</Base>

<style>
	.articles-page {
		padding: var(--spacing-16) 0 var(--spacing-20);
	}

	.page-header {
		margin-bottom: var(--spacing-12);
		border-bottom: 1px solid var(--color-border-subtle);
		padding-bottom: var(--spacing-8);
	}

	.page-title {
		font-family: var(--font-sans);
		font-size: clamp(2.25rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
	}

	.page-desc {
		font-family: var(--font-sans);
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
		max-width: 600px;
		margin-bottom: var(--spacing-6);
	}

	.category-pills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.cat-pill {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 500;
		padding: 6px 14px;
		border-radius: 9999px;
		background: var(--color-surface);
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
		transition: all var(--transition-fast);
	}

	.cat-pill:hover,
	.cat-pill.active {
		background: var(--color-text);
		color: var(--color-bg);
		border-color: var(--color-text);
	}

	/* Feed */
	.posts-feed {
		display: flex;
		flex-direction: column;
	}

	.feed-item {
		padding: var(--spacing-8) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.feed-item:first-child {
		padding-top: 0;
	}

	.feed-link {
		display: block;
	}

	.feed-meta {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-2);
	}

	.feed-author {
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	.feed-title {
		font-family: var(--font-sans);
		font-size: var(--font-size-2xl);
		font-weight: 700;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.feed-link:hover .feed-title {
		color: var(--color-brand);
	}

	.feed-excerpt {
		font-family: var(--font-serif);
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		margin-bottom: var(--spacing-3);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.feed-footer {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
	}

	.feed-read-time {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-brand);
	}

	.empty-state {
		padding: var(--spacing-16) 0;
		text-align: center;
		color: var(--color-muted);
	}
</style>
