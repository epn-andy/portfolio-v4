---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found">
	<div class="container-narrow" style="padding: var(--spacing-24) 0; text-align: center;">
		<div style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-brand); text-transform: uppercase; margin-bottom: var(--spacing-2);">404 // error</div>
		<h1 style="font-family: var(--font-sans); font-size: clamp(2.5rem, 6vw, 3.5rem); font-weight: 800; margin-bottom: var(--spacing-4);">Page not found</h1>
		<p style="color: var(--color-text-secondary); max-width: 480px; margin: 0 auto var(--spacing-8); line-height: var(--leading-relaxed);">
			The page you are looking for doesn't exist, has been moved, or the link is incorrect.
		</p>
		<a href="/" class="btn btn-primary">Return Home →</a>
	</div>
</Base>
