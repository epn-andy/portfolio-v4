---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: projects } = await getEmDashCollection("projects", {
	orderBy: { created_at: "desc" },
	limit: 50,
});
---

<Base
	title="Work"
	description="Projects by Eryandhi Putro Nugroho — web systems, IoT, computer vision, and developer tools."
>
	<div class="container-narrow work-page">
		<header class="page-header">
			<h1 class="page-title">Work</h1>
			<p class="page-desc">
				Selected projects across full-stack web systems, IoT, and computer vision.
			</p>
		</header>

		<div class="work-list">
			{projects.map((proj, idx) => (
				<article class="work-item">
					<div class="work-index">{String(idx + 1).padStart(2, "0")}</div>
					<div class="work-body">
						<h2 class="work-title">
							<a href={`/work/${proj.id}`}>{proj.data.title}</a>
						</h2>
						{proj.data.tech_stack && (
							<div class="work-tech">{proj.data.tech_stack}</div>
						)}
						{proj.data.summary && (
							<p class="work-summary">{proj.data.summary}</p>
						)}
						<div class="work-links">
							<a href={`/work/${proj.id}`} class="work-link">Case study →</a>
							{proj.data.url && (
								<a href={proj.data.url} target="_blank" rel="noopener noreferrer" class="work-link">Live ↗</a>
							)}
							{proj.data.github_url && (
								<a href={proj.data.github_url} target="_blank" rel="noopener noreferrer" class="work-link">Code ↗</a>
							)}
						</div>
					</div>
				</article>
			))}

			{projects.length === 0 && (
				<div class="empty-state">
					<p>No projects yet.</p>
				</div>
			)}
		</div>
	</div>
</Base>

<style>
	.work-page {
		padding: var(--spacing-16) 0 var(--spacing-20);
	}

	.page-header {
		margin-bottom: var(--spacing-12);
		border-bottom: 1px solid var(--color-border-subtle);
		padding-bottom: var(--spacing-8);
	}

	.page-title {
		font-family: var(--font-sans);
		font-size: clamp(2.25rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
	}

	.page-desc {
		font-family: var(--font-sans);
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
		max-width: 600px;
	}

	.work-list {
		display: flex;
		flex-direction: column;
	}

	.work-item {
		display: flex;
		gap: var(--spacing-6);
		padding: var(--spacing-8) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.work-index {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		padding-top: 4px;
		flex-shrink: 0;
	}

	.work-body {
		flex: 1;
		min-width: 0;
	}

	.work-title {
		font-family: var(--font-sans);
		font-size: var(--font-size-xl);
		font-weight: 700;
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-1);
	}

	.work-title a {
		color: var(--color-text);
		transition: color var(--transition-fast);
	}

	.work-title a:hover {
		color: var(--color-brand);
	}

	.work-tech {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-brand);
		margin-bottom: var(--spacing-2);
	}

	.work-summary {
		font-family: var(--font-serif);
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		margin-bottom: var(--spacing-3);
	}

	.work-links {
		display: flex;
		gap: var(--spacing-4);
	}

	.work-link {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-brand);
	}

	.work-link:hover {
		text-decoration: underline;
	}

	.empty-state {
		padding: var(--spacing-16) 0;
		text-align: center;
		color: var(--color-muted);
	}
</style>
